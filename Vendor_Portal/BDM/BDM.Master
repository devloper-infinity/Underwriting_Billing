        <script src="../plugins/datatables-buttons/js/buttons.colVis.min.js"></script>
        <script src="../plugins/datatables-fixedcolumns/js/dataTables.fixedColumns.min.js"></script>
        <script src="../plugins/datatables-fixedcolumns/js/dataTables.fixedColumns.js"></script>
        <script src="../plugins/datatables-fixedheader/js/dataTables.fixedHeader.min.js"></script>
        <script src="../plugins/datatables-fixedheader/js/dataTables.fixedHeader.js"></script>
        <!-- AdminLTE App -->
        <script src="../plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="../dist/js/adminlte.min.js"></script>
        <!-- AdminLTE for demo purposes -->


    </form>
</body>
</html>
